hDialog>\n\n    <embeddedServiceMessagingChannel>\n        <isEnabled>true</isEnabled>\n        <shouldShowTypingIndicators>false</shouldShowTypingIndicators>\n        <shouldShowReadReceipts>false</shouldShowReadReceipts>\n        <shouldShowDeliveryReceipts>false</shouldShowDeliveryReceipts>\n        <shouldShowEmojiSelection>false</shouldShowEmojiSelection>\n        <shouldStartNewLineOnEnter>false</shouldStartNewLineOnEnter>\n        <messagingChannel>EM1</messagingChannel>\n    </embeddedServiceMessagingChannel>\n\n    <embeddedServiceForms>\n        <isActive>true</isActive>\n        <displayContext>Session</displayContext>\n\n        <embeddedServiceFormFields>\n            <displayOrder>0</displayOrder>\n            <formField>_FirstName</formField>\n            <messagingChannelParameterType>Standard</messagingChannelParameterType>\n            <formFieldType>Text</formFieldType>\n            <isHidden>false</isHidden>\n            <isRequired>true</isRequired>\n            <embeddedServiceCustomLabels>\n                <customLabel>EM_PreChat_Base_PrechatCustomFieldLabel_133xx0000004GG2_5523048</customLabel>\n                <labelKey>EM_PreChat_Base_PrechatCustomFieldLabel</labelKey>\n                <feature>EmbeddedMessaging</feature>\n            </embeddedServiceCustomLabels>\n        </embeddedServiceFormFields>\n        <embeddedServiceFormFields>\n            <displayOrder>1</displayOrder>\n            <formField>_LastName</formField>\n            <messagingChannelParameterType>Standard</messagingChannelParameterType>\n            <formFieldType>Text</formFieldType>\n            <isHidden>false</isHidden>\n            <isRequired>true</isRequired>\n            <embeddedServiceCustomLabels>\n                <customLabel>EM_PreChat_Base_PrechatCustomFieldLabel_133xx0000004GG2_5523058</customLabel>\n                <labelKey>EM_PreChat_Base_PrechatCustomFieldLabel</labelKey>\n                <feature>EmbeddedMessaging</feature>\n            </embeddedServiceCustomLabels>\n        </embeddedServiceFormFields>\n        <embeddedServiceFormFields>\n            <displayOrder>2</displayOrder>\n            <formField>FavoriteFood_name</formField>\n            <messagingChannelParameterType>Custom</messagingChannelParameterType>\n            <formFieldType>ChoiceList</formFieldType>\n            <isHidden>false</isHidden>\n            <isRequired>true</isRequired>\n            <choiceList>Food</choiceList>\n        </embeddedServiceFormFields>\n    </embeddedServiceForms>\n</EmbeddedServiceConfig>"}],"wsdl_enums":{"EmbeddedServiceAuthMethod":["CommunitiesLogin","CustomLogin"],"EmbeddedServiceClientVersion":["WebV1","WebV2"],"EmbeddedServiceComponentBundleType":["AuraDefinitionBundle","LightningComponentBundle"],"EmbeddedServiceCustomComponentType":["LA_Prechat","LA_Minimized","LA_PlainTextChatMessage","LA_ChatHeader","MIAW_Prechat","MIAW_Header","MIAW_TextMessage"],"EmbeddedServiceDeploymentFeature":["None","EmbeddedMessaging","LiveAgent","Flows","FieldService"],"EmbeddedServiceDeploymentType":["Web","Mobile","API","InternalCopilot"],"EmbeddedServiceFeature":["NotInUse","Base","LiveAgent","FieldService","Flows","ChannelMenu","EmbeddedMessaging"],"EmbeddedServiceFlowType":["FL_Flow","FS_NewAppointment","FS_ModifyAppointment","FS_CancelAppointment","LA_Survey"],"EmbeddedServiceFormDisplayContext":["None","Conversation","Session"],"EmbeddedServiceFormFieldType":["Text","Email","Phone","Number","Checkbox","ChoiceList"],"EmbeddedServiceLabelKey":["LA_Container_Base_Close","LA_Container_Base_Minimize","LA_Container_Base_EndOfDialog","LA_Container_Base_MinimizedContainerAssistiveText","LA_Chat_Body_ChatWindowAgent","LA_Chat_Body_InputTextPlaceholder","LA_Chat_Body_AgentTypingUpdate","LA_Chat_Body_Send","LA_Chat_Body_ChatStartTime","LA_Chat_Body_MessageAreaTransferred","LA_Chat_Body_FileTransferCanceled","LA_Chat_Body_FileTransferSuccess","LA_Chat_Body_FileTransferFailure","LA_Chat_Body_FileTransferRequested","LA_Chat_Body_Tra